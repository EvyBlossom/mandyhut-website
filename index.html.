<main id="top"><section class="hero"><div class="eyebrow">Jewellery & accessories</div><h1>MANDYHUT</h1><p>Bijzondere sieraden en accessoires met oog voor detail. Ontdek jouw favorieten in onze collectie.</p><a class="btn" href="#collectie">Bekijk de collectie</a></section>
<section id="collectie" class="section"><div class="section-head"><div class="eyebrow">Made to be loved</div><h2>Onze collectie</h2><p>Bekijk onze sieraden en ontdek jouw favorieten. Bestellen gaat eenvoudig via Vinted.</p></div><div id="products" class="products"><p class="status">Collectie wordt geladen…</p></div></section>
<section id="over" class="about"><div class="eyebrow">A little something special</div><h2>Over Mandyhut</h2><p>Welkom bij Mandyhut! Een collectie sieraden en accessoires, met liefde geselecteerd en samengesteld. Bekijk onze items en shop via ons Vinted-account.</p><p style="margin-top:28px"><a class="btn btn-outline" href="https://www.vinted.nl/member/34138701-mandyhut" target="_blank" rel="noopener noreferrer">Bezoek onze Vinted</a></p></section></main>
<footer class="footer">© <span id="year"></span> Mandyhut · Jewellery & Accessories · <a href="https://www.vinted.nl/member/34138701-mandyhut" target="_blank" rel="noopener noreferrer">Vinted</a></footer>
<script>
const VINTED='https://www.vinted.nl/member/34138701-mandyhut';
document.getElementById('year').textContent=new Date().getFullYear();
const container=document.getElementById('products');
function text(el,value){el.textContent=value==null?'':String(value);return el}
function imagePath(raw){if(!raw)return '';if(typeof raw==='object')raw=raw.src||raw.path||raw.url||'';let value=String(raw).trim();if(!value)return '';if(/^https?:\/\//i.test(value))return value;if(value.startsWith('/'))return value;return '/'+value.replace(/^\.\//,'')}
function productCard(item,index){const card=document.createElement('article');card.className='product';const photo=document.createElement('div');photo.className='photo';let src=imagePath(item.image||item.photo||item.afbeelding||item.foto||item.images?.[0]);if(!src)src='/images/product-'+String(index+1).padStart(2,'0')+'.jpeg';const img=document.createElement('img');img.src=src;img.loading='lazy';img.alt=String(item.name||item.title||'Sieraad');img.onerror=()=>{img.remove();photo.appendChild(text(Object.assign(document.createElement('span'),{className:'placeholder'}),'MANDYHUT'))};photo.appendChild(img);card.appendChild(photo);const info=document.createElement('div');info.className='info';const title=document.createElement('h3');text(title,item.name||item.title||'Sieraad');info.appendChild(title);const desc=item.description||item.beschrijving||item.material||item.materiaal;if(desc){const p=document.createElement('p');p.className='description';text(p,desc);info.appendChild(p)}const price=item.price??item.prijs;if(price!==undefined&&price!==null&&String(price).trim()!==''){const p=document.createElement('p');p.className='price';const raw=String(price).trim();text(p,raw.includes('€')?raw:'€ '+raw);info.appendChild(p)}const link=document.createElement('a');link.className='small-btn';link.href=typeof item.vinted_url==='string'&&/^https:\/\//.test(item.vinted_url)?item.vinted_url:(typeof item.link==='string'&&/^https:\/\//.test(item.link)?item.link:VINTED);link.target='_blank';link.rel='noopener noreferrer';link.textContent='Bekijk op Vinted ↗';info.appendChild(link);card.appendChild(info);return card}
fetch('/data/products.json',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error('HTTP '+r.status);return r.json()}).then(data=>{const products=Array.isArray(data)?data:(Array.isArray(data.products)?data.products:[]);container.replaceChildren();if(!products.length){container.appendChild(text(Object.assign(document.createElement('p'),{className:'status'}),'Binnenkort vind je hier onze collectie.'));return}products.forEach((item,index)=>container.appendChild(productCard(item,index)))}).catch(()=>{container.replaceChildren(text(Object.assign(document.createElement('p'),{className:'status'}),'De collectie kan momenteel niet geladen worden. Probeer het later opnieuw.'))});
</script>
