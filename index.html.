<style>
:root{--cream:#f8f5f0;--sand:#ede4d8;--ink:#342b25;--muted:#75695f;--line:#e2d8cc;--gold:#9b7957}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}header{position:sticky;top:0;z-index:5;background:rgba(248,245,240,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.nav{max-width:1180px;margin:auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{font-family:Georgia,serif;letter-spacing:.13em;font-size:24px}.navlinks{display:flex;gap:24px;align-items:center;font-size:13px;letter-spacing:.05em}.navlinks a:hover{color:var(--gold)}.hero{background:linear-gradient(125deg,#f4ede4,#e7d9c8);text-align:center;padding:104px 22px 110px}.eyebrow{text-transform:uppercase;letter-spacing:.27em;font-size:11px;color:var(--gold);font-weight:bold}.hero h1{font-family:Georgia,serif;font-weight:normal;font-size:clamp(46px,9vw,88px);letter-spacing:.06em;margin:20px 0 15px}.hero p{max-width:540px;margin:0 auto 32px;color:var(--muted);line-height:1.7}.btn{display:inline-block;background:var(--ink);color:white;padding:15px 27px;font-size:12px;letter-spacing:.13em;text-transform:uppercase;border:1px solid var(--ink);transition:.2s}.btn:hover{background:transparent;color:var(--ink)}.btn-outline{background:transparent;color:var(--ink)}.btn-outline:hover{background:var(--ink);color:white}.section{max-width:1180px;margin:auto;padding:78px 24px}.section-head{text-align:center;margin-bottom:40px}.section-head h2{font:normal clamp(32px,5vw,48px) Georgia,serif;margin:12px 0}.section-head p{color:var(--muted);font-size:14px;line-height:1.6}.products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 22px}.product{min-width:0}.photo{background:#ece5db;aspect-ratio:1/1.14;overflow:hidden;display:flex;align-items:center;justify-content:center}.photo img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.product:hover img{transform:scale(1.045)}.placeholder{color:#a79a8c;font-family:Georgia,serif;font-size:23px}.info{padding:16px 3px 4px}.info h3{font:normal 21px Georgia,serif;margin:0 0 8px}.description{font-size:13px;line-height:1.55;color:var(--muted);margin:0 0 10px}.price{font-size:14px;font-weight:bold;margin:0 0 16px}.small-btn{font-size:11px;letter-spacing:.09em;text-transform:uppercase;border-bottom:1px solid var(--gold);padding-bottom:5px;display:inline-block}.about{background:var(--sand);text-align:center;padding:70px 24px}.about h2{font:normal 38px Georgia,serif;margin:14px 0}.about p{max-width:620px;margin:0 auto;color:var(--muted);line-height:1.8;font-size:14px}.footer{padding:34px 24px;text-align:center;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}.status{text-align:center;color:var(--muted);padding:24px;grid-column:1/-1} @media(max-width:700px){.nav{padding:16px}.brand{font-size:20px}.navlinks{gap:13px;font-size:11px}.hero{padding:77px 18px 83px}.section{padding:56px 16px}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 13px}.info h3{font-size:18px}.description{font-size:12px}.about{padding:55px 20px}}@media(max-width:380px){.navlinks a:first-child{display:none}}
</style>
